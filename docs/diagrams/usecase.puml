@startuml
skinparam defaultFontName "Segoe UI"
skinparam handwritten false
skinparam packageStyle rectangle
skinparam shadowing true

skinparam actor {
  BackgroundColor #EFF6FF
  BorderColor #2563EB
}
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #0284C7
  ArrowColor #2563EB
}

left to right direction

actor "Người dùng\n(Cá nhân / User)" as User

rectangle "Hệ thống Soạn thảo & Quản lý Ghi chú Mã nguồn mở MarkNote" {
  package "Quản lý Ghi chú & Soạn thảo" {
    usecase "UC01: Tạo ghi chú mới" as UC01
    usecase "UC02: Mở / Xem ghi chú" as UC02
    usecase "UC03: Sửa ghi chú (Ctrl+S)" as UC03
    usecase "UC04: Xóa ghi chú (Cascade)" as UC04
    usecase "UC05: Gắn / Gỡ nhãn Tag" as UC05
    usecase "UC08: Tìm trong ghi chú (Ctrl+F)" as UC08
    usecase "UC09: Thay thế văn bản (Ctrl+H)" as UC09
  }

  package "Trình diễn & Tra cứu FTS5" {
    usecase "UC06: Live Preview song song\n(Debounce timer 300ms)" as UC06
    usecase "UC07: Bật / Tắt Cuộn đồng bộ\n(Sync Scroll Engine)" as UC07
    usecase "UC10: Tìm toàn kho FTS5\n(& Lọc nhãn tag:)" as UC10
  }

  package "Giao diện & Xuất bản In ấn" {
    usecase "UC11: Xem danh sách theme" as UC11
    usecase "UC12: Chuyển đổi theme" as UC12
    usecase "UC13: Xuất PDF / HTML in ấn\n(WeasyPrint A4 W3C CSS)" as UC13
  }
}

User --> UC01
User --> UC02
User --> UC03
User --> UC04
User --> UC05
User --> UC06
User --> UC07
User --> UC08
User --> UC09
User --> UC10
User --> UC11
User --> UC12
User --> UC13

UC06 ..> UC12 : <<include>>
UC06 ..> UC11 : <<include>>
UC10 ..> UC02 : <<include>>
UC13 ..> UC06 : <<include>>
UC13 ..> UC12 : <<include>>

@enduml
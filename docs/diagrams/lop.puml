@startuml
skinparam defaultFontName "Segoe UI"
skinparam classAttributeIconSize 0
skinparam shadowing true
skinparam ranksep 60
skinparam nodesep 50

class DbManager {
  - _db_path : Path
  + get_connection() : sqlite3.Connection
  + init_schema() : void
}

class NoteDAO {
  - db : DbManager
  + insert(title: str, content_md: str) : int
  + update(note_id: int, content_md: str) : void
  + delete(note_id: int) : void
  + getById(note_id: int) : dict
  + list(tag_name: str) : list
  + searchFTS(query: str, tag_name: str) : list
}

class TagDAO {
  - db : DbManager
  + listAll() : list
  + create(name: str, color: str) : int
  + assign(note_id: int, tag_id: int) : void
  + unassign(note_id: int, tag_id: int) : void
}

class SettingsDAO {
  - db : DbManager
  + get(key: str, default: str) : str
  + set(key: str, val: str) : void
}

class MarkdownRenderer {
  - md_parser : MarkdownIt
  + render(md_text: str) : str
  + parse_donut_spec(text: str) : dict
  + render_donut_widget(spec: dict) : str
}

class Exporter {
  + toHtml(html_body: str, css: str, path: str) : void
  + toPdf(html_body: str, css: str, path: str) : void
}

class ThemeManager {
  - settings : SettingsDAO
  - current_theme : str
  + listThemes() : list
  + getCss(theme_name: str) : str
  + applyTheme(theme_name: str) : void
}

class MainWindow {
  - editor : EditorPane
  - preview : PreviewPane
  - notes : NoteDAO
  - tags : TagDAO
  - settings : SettingsDAO
  - renderer : MarkdownRenderer
  - exporter : Exporter
  + openNote(id: int) : void
  + save() : void
  + onExportPdf() : void
  + _on_sync_toggled(bool) : void
}

MainWindow "1" *-- "1" NoteDAO
MainWindow "1" *-- "1" TagDAO
MainWindow "1" *-- "1" SettingsDAO
MainWindow "1" *-- "1" MarkdownRenderer
MainWindow "1" *-- "1" Exporter
MainWindow "1" *-- "1" ThemeManager

NoteDAO --> DbManager
TagDAO --> DbManager
SettingsDAO --> DbManager

@enduml
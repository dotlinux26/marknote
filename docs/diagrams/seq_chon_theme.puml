@startuml
skinparam defaultFontName "Segoe UI"
skinparam shadowing true

autonumber
actor "Người dùng" as User
participant "Menu Cài đặt\nAppearanceMenu" as Menu
participant "Quản trị Theme\nThemeManager" as ThemeMgr
participant "Cấu hình\nSettingsDAO" as Settings
participant "Xem trước\nPreviewPane" as Preview

User -> Menu : Chọn chủ đề "dark"
Menu -> ThemeMgr : applyTheme("dark")
ThemeMgr -> Settings : set("theme", "dark")
ThemeMgr -> ThemeMgr : Đọc nội dung tệp assets/themes/dark.css
ThemeMgr -> Preview : reloadCss()
Preview -> Preview : Nạp CSS mới vào QWebEngineView (Không khởi động lại)
Preview --> User : Toàn bộ giao diện chuyển sang chế độ tối (Dark Mode)

@enduml
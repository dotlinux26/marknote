@startuml
skinparam defaultFontName "Segoe UI"
skinparam packageStyle rectangle
skinparam shadowing true
skinparam ranksep 50
skinparam nodesep 50

package "Tầng Giao diện Người dùng (Presentation Layer / View)" {
  class MainWindow
  class EditorPane
  class PreviewPane
  class SearchPanel
}

package "Tầng Xử lý Nghiệp vụ & Động cơ (Business Logic & Engine)" {
  class MarkdownRenderer
  class SyncScrollController
  class ThemeManager
  class Exporter
}

package "Tầng Truy cập Dữ liệu (Data Access Layer / DAO)" {
  class DbManager
  class NoteDAO
  class TagDAO
  class SettingsDAO
  class SQLite_FTS5 <<Database Engine>>
}

MainWindow --> EditorPane
MainWindow --> PreviewPane
MainWindow --> SearchPanel
MainWindow --> SyncScrollController
MainWindow --> MarkdownRenderer
MainWindow --> ThemeManager
MainWindow --> Exporter

MainWindow --> NoteDAO
MainWindow --> TagDAO
MainWindow --> SettingsDAO

NoteDAO --> DbManager
TagDAO --> DbManager
SettingsDAO --> DbManager
DbManager --> SQLite_FTS5

@enduml
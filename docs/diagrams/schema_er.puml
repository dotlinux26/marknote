@startuml
skinparam defaultFontName "Segoe UI"
skinparam ranksep 85
skinparam nodesep 80
skinparam shadowing true
skinparam roundcorner 8

skinparam entity {
  BackgroundColor #FFFFFF
  BorderColor #2563EB
  ArrowColor #4F46E5
  FontSize 12
}

entity "notes\n(Bảng Ghi chú)" as notes {
  * **id** : INTEGER <<PK>>
  --
  * **title** : TEXT NOT NULL
  content_md : TEXT
  created_at : DATETIME
  updated_at : DATETIME
  pinned : INTEGER (0 / 1)
  archived : INTEGER (0 / 1)
}

entity "tags\n(Bảng Nhãn phân loại)" as tags {
  * **id** : INTEGER <<PK>>
  --
  * **name** : TEXT <<UNIQUE>>
  color : TEXT (HEX #rrggbb)
}

entity "note_tag\n(Bảng liên kết quan hệ N:N)" as note_tag {
  * **note_id** : INTEGER <<FK>>
  * **tag_id** : INTEGER <<FK>>
  --
  PRIMARY KEY (note_id, tag_id)
  ON DELETE CASCADE
}

entity "settings\n(Bảng Cấu hình hệ thống)" as settings {
  * **key** : TEXT <<PK>>
  --
  value : TEXT
}

entity "notes_fts\n(Bảng ảo SQLite FTS5)" as notes_fts <<Virtual Table>> {
  title : TEXT
  content_md : TEXT
  --
  content = 'notes'
  tokenize = 'porter unicode61'
}

notes ||--right--o{ note_tag : "  1 .. N  "
tags ||--left--o{ note_tag : "  1 .. N  "

notes ..down..> notes_fts : "\nĐồng bộ tự động qua\n3 Database Triggers\n(INSERT, UPDATE, DELETE)\n"

note right of settings
  Lưu cấu hình cục bộ:
  theme = 'default' | 'dark'
  sync_scroll = 'ON' | 'OFF'
end note

@enduml